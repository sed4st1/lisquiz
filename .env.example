# ==============================================================
# Лисквиз (Lisquiz) - Пример конфигурации переменных окружения
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================

# --- Сервер и безопасность ---
HOST=0.0.0.0
PORT=8000
DEBUG=True
SECRET_KEY=lisquiz-hackathon-super-secret-key-2026
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://dev.max.ru

# --- Платформа MAX / Сферум ---
# Токен бота, полученный от чат-бота «Идея фикс»
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_APP_ID=your_max_app_id_here
MAX_APP_SECRET=your_max_app_secret_here
MAX_WEBHOOK_URL=https://your-domain.ru/api/max/webhook

# --- ИИ-провайдер генерации вопросов (LLM) ---
# Доступные значения: mock (по умолчанию для локального тестирования без ключей), gigachat, yandexgpt
LLM_PROVIDER=mock

# Сбер GigaChat (если LLM_PROVIDER=gigachat)
GIGACHAT_CREDENTIALS=your_gigachat_auth_credentials_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Яндекс GPT (если LLM_PROVIDER=yandexgpt)
YANDEX_GPT_API_KEY=your_yandex_gpt_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# --- База данных и Redis ---
# Для локального запуска по умолчанию используется SQLite
DATABASE_URL=sqlite+aiosqlite:///./lisquiz.db
# Для запуска в Docker Compose используется PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://lisquiz:lisquiz_password@db:5432/lisquiz_db

# Redis для состояния игровых комнат (при отсутствии используется in-memory fallback)
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
