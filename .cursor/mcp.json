{
  "mcpServers": {
    "shadcn": {
      "command": "shadcn",
      "args": ["mcp"]
    },
    "shadcn-ui-mcp": {
      "command": "shadcn-ui-mcp-server",
      "args": []
    },
    "origin-ui": {
      "command": "npx",
      "args": ["--yes", "github:kelvinchng/origin-ui-mcp"]
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "ENV_21ST_API_KEY"
      }
    }
  }
}
